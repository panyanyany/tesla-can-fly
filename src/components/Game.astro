---
const {lang}=Astro.props;
---
<canvas id="scene" aria-label="3D driving scene"></canvas><div id="hud">
<header><a class="brand" href={`/${lang}/`} aria-label={lang==='zh'?'返回首页':'Back to home'}><span class="mark">R /</span> ROADSTER <small>FLIGHT LAB</small></a><span class="live"><i></i> McGREGOR · NIGHT SESSION</span><button id="camera" data-i18n="视角 C"></button><select id="language" aria-label="Language"><option value="zh">简体中文</option><option value="en">English</option></select></header>
<aside><div class="eyebrow" data-i18n="EXPERIMENT 001 / 冷气推进"></div><h1 data-i18n="地面，只是起点。"></h1><p data-i18n="吸附 · 腾空 · 翻转 · 着陆"></p><div class="mode"><span id="mode"></span><b id="stage"></b></div></aside>
<div class="telemetry"><div><span id="speed">000</span><small data-i18n="KM/H / 速度"></small></div><div><span id="alt">0.0</span><small data-i18n="METERS / 高度"></small></div><div><span id="gas">100</span><small data-i18n="% / 储气量"></small><div class="bar"><i id="gasbar"></i></div></div><div class="fan"><span id="fan">STANDBY</span><small data-i18n="SUCTION / 风扇吸附"></small></div></div>
<div id="result" hidden role="status" aria-live="polite"></div>
<div id="orientation-hint" hidden><span data-i18n="竖屏仅供观看 · 转为横屏即可驾驶"></span><button id="dismiss-orientation" data-i18n="知道了"></button></div>
<div id="language-notice" hidden><span id="language-message"></span><button id="switch-language"></button><button id="dismiss-language" data-i18n="关闭"></button></div>
<div id="touch-controls" aria-label="Touch controls"><div class="touch-left"><div class="pedals"><button data-hold="KeyS" data-i18n="制动"></button><button data-hold="KeyW" data-i18n="加速"></button></div><button id="touch-fan" aria-pressed="false" data-i18n="吸附锁定"></button></div><div class="touch-right"><div id="joystick" role="group" aria-label="Attitude joystick"><span id="stick"></span><small data-i18n="姿态"></small></div><button id="touch-thrust" data-hold="Space" data-i18n="喷气"></button><div class="lane"><button data-hold="KeyA" aria-label="Move left">A ◀</button><button data-hold="KeyD" aria-label="Move right">▶ D</button></div></div></div>
<footer><div class="controls"><span><kbd>W S</kbd> <span data-i18n="加速 / 制动"></span></span><span><kbd>SHIFT</kbd> <span data-i18n="吸附"></span></span><span><kbd>SPACE</kbd> <span data-i18n="喷气"></span></span><span><kbd>← →</kbd> <span data-i18n="空中翻滚 / 转向"></span></span><span><kbd>↑ ↓</kbd> <span data-i18n="俯仰"></span></span><span><kbd>R</kbd> <span data-i18n="重来"></span></span></div><div class="actions"><button id="demo" class="secondary" data-i18n="↻ 自动演示"></button><button id="play"></button></div><p class="note" data-i18n="概念场景 · 简化游戏物理 · 非车辆性能模拟"></p></footer>
</div>
<script>import "../main.js";</script>
