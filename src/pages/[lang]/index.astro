---
import SiteLayout from '../../layouts/SiteLayout.astro';
export function getStaticPaths(){return ['zh','en'].map(lang=>({params:{lang}}))}
const {lang}=Astro.params;const zh=lang==='zh';
const steps=zh?[
 ['01','贴住地面。','开启风扇吸附，沿 C 形坡道驶向倒挂段。'],
 ['02','离开地面。','脱离坡道，用有限的冷气推进调整空中姿态。'],
 ['03','漂亮落地。','对准绿色着陆区，让整辆车在线内停稳。']
]:[
 ['01','Hold the ground.','Engage suction and climb the C-shaped ramp, all the way upside down.'],
 ['02','Leave the ground.','Launch from the ramp. Use a limited air reserve to control your attitude.'],
 ['03','Stick the landing.','Line up with the green landing zone. Stop with the whole car inside.']
];
---
<SiteLayout lang={lang} title={zh?'特斯拉能飞 — 地面，只是起点。':'Tesla Can Fly — Beyond the ground.'} description={zh?'驾驶概念电动超跑，完成坡道吸附、空中调姿和精准着陆。支持电脑与手机横屏操作。':'Drive a concept electric supercar through suction ramps, mid-air maneuvers and precision landings. Play on desktop or mobile landscape.'}>
<main id="top"><section class="hero"><div class="hero-copy"><p class="eyebrow"><i></i> EXPERIMENT 001 / TESLA CAN FLY</p><h1>{zh?<>地面，<br/>只是起点。</>:<>Beyond<br/>the ground.</>}</h1><p class="hero-description">{zh?'一段坡道，一罐空气，一次漂亮落地。驾驶概念超跑，亲手完成从倒挂到腾空的挑战。':'One ramp. One air reserve. One perfect landing. Take control of a concept supercar, from upside down to airborne.'}</p><a class="cta" href={`/${lang}/play/`}>{zh?'进入飞行挑战':'Start flying'} <span>↗</span></a><p class="hero-note">{zh?'免费浏览器游戏 · 无需下载 · 手机横屏可玩':'Free browser game · No download · Mobile landscape controls'}</p></div><div class="hero-visual"><img src="/images/roadster-hero.jpg" alt={zh?'白色楔形概念超跑停在夜间测试场':'White wedge-shaped concept supercar at the night test facility'} width="1400" height="900" fetchpriority="high"/><div class="visual-grid"></div><div class="visual-tag"><span>T / 001</span><small>{zh?'准备突破地面':'READY TO LEAVE THE GROUND'}</small></div><div class="visual-caption"><span>SUCTION + COLD GAS</span><span>McGREGOR / NIGHT SESSION</span></div></div></section>
<div class="ticker"><span>{zh?'吸附':'SUCTION'}</span><b>+</b><span>{zh?'推进':'THRUST'}</span><b>+</b><span>{zh?'控制':'CONTROL'}</span><small>{zh?'不是持续飞行，是一次精准的腾空挑战。':'A precision airborne challenge, not sustained flight.'}</small></div>
<section id="mission" class="section mission"><div class="section-heading"><p class="eyebrow">01 / THE MISSION</p><h2>{zh?'起跳容易。\n落地，才是挑战。':"Taking off is easy.\nLanding is the challenge."}</h2><p>{zh?'先看一遍演示，再接管驾驶。每次落地都有明确的检查与反馈。':'Watch the demo, then take the controls. Every landing gives you a clear breakdown of what worked.'}</p></div><div class="steps">{steps.map(([n,title,body])=><article><span class="step-number">{n}</span><div class:list={['step-icon',`step-${n}`]} aria-hidden="true"><i></i></div><h3>{title}</h3><p>{body}</p></article>)}</div></section>
<section id="systems" class="section systems"><div><p class="eyebrow">02 / TWO SYSTEMS. ONE RUN.</p><h2>{zh?'贴地的力量。\n腾空的自由。':'Grip the surface.\nControl the air.'}</h2><p>{zh?'两套系统，各有职责。风扇帮助车辆贴住坡道；冷气喷口负责空中调姿，并消耗储气。':'Two systems, two jobs. Fans hold the car to the ramp. Cold-gas thrusters control it in the air, using a finite reserve.'}</p></div><div class="system-cards"><article><span>01 / SUCTION</span><h3>{zh?'风扇吸附':'Fan suction'}</h3><p>{zh?'通过倒挂段时保持开启。腾空后，吸附不能代替升力。':'Keep it engaged through the inverted section. Once airborne, suction cannot provide lift.'}</p></article><article><span>02 / COLD GAS</span><h3>{zh?'冷气推进':'Cold-gas thrust'}</h3><p>{zh?'调正车身再点按喷气。每次操作，都在消耗有限的空气储备。':'Level the car, then pulse the thrusters. Every burst spends some of your limited air.'}</p></article></div></section>
<section class="final-cta"><p class="eyebrow">YOUR NEXT ATTEMPT STARTS HERE</p><h2>{zh?'准备好漂亮落地了吗？':'Ready to stick the landing?'}</h2><a class="cta" href={`/${lang}/play/`}>{zh?'进入飞行挑战':'Start flying'} <span>↗</span></a><p>{zh?'电脑使用键盘 · 手机请转为横屏 · 竖屏可观看演示':'Keyboard on desktop · Rotate your phone to drive · Watch in portrait'}</p></section>
</main>
</SiteLayout>
