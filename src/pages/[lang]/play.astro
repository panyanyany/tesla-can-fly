---
import Game from '../../components/Game.astro';
import Analytics from '../../components/Analytics.astro';
export function getStaticPaths(){return ['zh','en'].map(lang=>({params:{lang}}))}
const {lang}=Astro.params;
---
<!doctype html><html lang={lang==='zh'?'zh-CN':'en'}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/><meta name="theme-color" content="#08111e"/><title>{lang==='zh'?'飞行挑战 · 特斯拉能飞':'Play · Tesla Can Fly'}</title><meta name="description" content={lang==='zh'?'驾驶概念超跑，挑战精准着陆。':'Drive the concept supercar and master a precision landing.'}/><link rel="alternate" hreflang="zh-CN" href="/zh/play/"/><link rel="alternate" hreflang="en" href="/en/play/"/><Analytics/></head><body><Game lang={lang}/></body></html>
